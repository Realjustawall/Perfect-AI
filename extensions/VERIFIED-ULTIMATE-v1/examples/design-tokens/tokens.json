{
  "$description": "DTCG test tokens; brand should replace after approval",
  "palette": {
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.06,
          0.06,
          0.06
        ]
      }
    },
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.97,
          0.97,
          0.97
        ]
      }
    }
  },
  "semantic": {
    "background": {
      "$type": "color",
      "$value": "{palette.black}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{palette.white}"
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "motion": {
    "standard": {
      "$type": "duration",
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    }
  }
}
